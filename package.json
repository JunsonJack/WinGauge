{
  "name": "wingauge",
  "private": true,
  "version": "0.1.0",
  "description": "Windows 托盘悬浮系统监控面板",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "build:ui": "npm run build --prefix frontend",
    "tauri": "npx --yes @tauri-apps/cli",
    "tauri:dev": "npm run build && npx --yes @tauri-apps/cli dev",
    "tauri:build": "npm run build && npx --yes @tauri-apps/cli build",
    "tauri:portable": "npm run tauri:build; powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-portable.ps1",
    "portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-portable.ps1",
    "smoke": "cargo run -p wingauge-core --example smoke_tick",
    "test": "cargo test -p wingauge-core"
  }
}
